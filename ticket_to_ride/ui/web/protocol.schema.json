{
  "$defs": {
    "Ack": {
      "additionalProperties": false,
      "description": "The reply to an `act`. A duplicate -- the same action for a ply already played by\nyou -- changes nothing and says so.",
      "properties": {
        "type": {
          "const": "ack",
          "type": "string"
        },
        "ply": {
          "type": "integer"
        },
        "action": {
          "type": "integer"
        },
        "duplicate": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "ply",
        "action",
        "duplicate"
      ],
      "title": "Ack",
      "type": "object"
    },
    "Act": {
      "additionalProperties": false,
      "description": "Play `action` at `ply` -- the count of actions played before it, so a double click\nor a reconnect can never apply a move twice.",
      "properties": {
        "type": {
          "const": "act",
          "type": "string"
        },
        "ply": {
          "minimum": 0,
          "type": "integer"
        },
        "action": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "type",
        "ply",
        "action"
      ],
      "title": "Act",
      "type": "object"
    },
    "Action": {
      "discriminator": {
        "mapping": {
          "claim": "#/$defs/ClaimAction",
          "draw": "#/$defs/DrawAction",
          "draw_tickets": "#/$defs/DrawTicketsAction",
          "keep": "#/$defs/KeepAction",
          "pass": "#/$defs/PassAction"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ClaimAction"
        },
        {
          "$ref": "#/$defs/DrawAction"
        },
        {
          "$ref": "#/$defs/DrawTicketsAction"
        },
        {
          "$ref": "#/$defs/KeepAction"
        },
        {
          "$ref": "#/$defs/PassAction"
        }
      ]
    },
    "Agent": {
      "additionalProperties": false,
      "description": "An opponent the server will seat.",
      "properties": {
        "spec": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "anchor": {
          "description": "True for H3 itself, the fixed point of the rating scale.",
          "type": "boolean"
        },
        "player": {
          "$ref": "#/$defs/Player"
        },
        "behaviour_hash": {
          "type": "string"
        },
        "ratings": {
          "items": {
            "$ref": "#/$defs/MapRating"
          },
          "type": "array"
        }
      },
      "required": [
        "spec",
        "name",
        "family",
        "description",
        "anchor",
        "player",
        "behaviour_hash",
        "ratings"
      ],
      "title": "Agent",
      "type": "object"
    },
    "ApiError": {
      "additionalProperties": false,
      "description": "The body of every REST error, under `detail`.",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ApiError",
      "type": "object"
    },
    "Board": {
      "additionalProperties": false,
      "description": "A board as the engine plays it, in the engine's order -- the client's only source of\nboard data, since mini's TOML is not in engine order.",
      "properties": {
        "name": {
          "$ref": "#/$defs/MapName"
        },
        "data_hash": {
          "type": "string"
        },
        "cities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/Segment"
          },
          "type": "array"
        },
        "tickets": {
          "items": {
            "$ref": "#/$defs/Ticket"
          },
          "type": "array"
        },
        "colors": {
          "description": "Colour names; card type i < len(colors) is colors[i].",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "locomotive": {
          "description": "The locomotive's card type: len(colors).",
          "type": "integer"
        },
        "card_counts": {
          "description": "Cards printed per card type.",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "trains_per_player": {
          "description": "Train pieces each seat starts with.",
          "type": "integer"
        },
        "end_trigger_trains": {
          "description": "A seat ending its turn with this many train pieces or fewer starts the final round: every seat, itself included, gets one more turn.",
          "type": "integer"
        },
        "route_points": {
          "description": "route_points[n] scores a route of length n.",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "longest_bonus": {
          "type": "integer"
        },
        "players": {
          "description": "[fewest, most] seats the map supports.",
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "initial_ticket_deal": {
          "type": "integer"
        },
        "initial_ticket_keep_min": {
          "type": "integer"
        },
        "draw_ticket_deal": {
          "type": "integer"
        },
        "draw_ticket_keep_min": {
          "type": "integer"
        },
        "faceup_slots": {
          "type": "integer"
        },
        "action_space": {
          "type": "integer"
        },
        "layout": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "description": "The client's drawing of this board (ticket_to_ride/data/layout/{map}.json), passed through verbatim; null until it is generated."
        }
      },
      "required": [
        "name",
        "data_hash",
        "cities",
        "segments",
        "tickets",
        "colors",
        "locomotive",
        "card_counts",
        "trains_per_player",
        "end_trigger_trains",
        "route_points",
        "longest_bonus",
        "players",
        "initial_ticket_deal",
        "initial_ticket_keep_min",
        "draw_ticket_deal",
        "draw_ticket_keep_min",
        "faceup_slots",
        "action_space",
        "layout"
      ],
      "title": "Board",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "What the decision compared; null when ruled out."
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "terms": {
          "description": "Additive, in points; they sum to `total`.",
          "items": {
            "$ref": "#/$defs/Term"
          },
          "type": "array"
        },
        "facts": {
          "description": "Inputs behind the terms, each in its own unit.",
          "items": {
            "$ref": "#/$defs/Term"
          },
          "type": "array"
        }
      },
      "required": [
        "action",
        "total",
        "rule",
        "terms",
        "facts"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "ClaimAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "claim",
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "segment": {
          "type": "integer"
        },
        "color": {
          "description": "The card type paid with; the locomotive for all-locomotive.",
          "type": "integer"
        },
        "colored": {
          "description": "Cards of `color` spent.",
          "type": "integer"
        },
        "locomotives": {
          "type": "integer"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "segment",
        "color",
        "colored",
        "locomotives",
        "label"
      ],
      "title": "ClaimAction",
      "type": "object"
    },
    "ClientMessage": {
      "discriminator": {
        "mapping": {
          "act": "#/$defs/Act"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Act"
        }
      ],
      "title": "ClientMessage"
    },
    "DrawAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "draw",
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "slot": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The face-up slot; null for the top of the deck."
        },
        "card": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The card taken: always for face-up, for the deck only to its drawer."
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "slot",
        "card",
        "label"
      ],
      "title": "DrawAction",
      "type": "object"
    },
    "DrawTicketsAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "draw_tickets",
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "dealt": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Tickets dealt (in a log entry)."
        },
        "tickets": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Which, to the drawer only."
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "dealt",
        "tickets",
        "label"
      ],
      "title": "DrawTicketsAction",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "bad_message",
        "not_found",
        "spectating",
        "game_over",
        "not_your_turn",
        "stale_ply",
        "future_ply",
        "illegal_action",
        "replay_mismatch",
        "unavailable"
      ],
      "type": "string"
    },
    "ErrorMessage": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "error",
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "ply": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "type",
        "code",
        "message",
        "ply"
      ],
      "title": "ErrorMessage",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "description": "One action, as the viewer may see it, and the position after it.",
      "properties": {
        "type": {
          "const": "event",
          "type": "string"
        },
        "entry": {
          "$ref": "#/$defs/LogEntry"
        },
        "view": {
          "$ref": "#/$defs/View"
        },
        "legal": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "type": "array"
        },
        "explanation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Explanation"
            },
            {
              "type": "null"
            }
          ],
          "description": "Spectating only."
        },
        "think_ms": {
          "type": "integer"
        }
      },
      "required": [
        "type",
        "entry",
        "view",
        "legal",
        "explanation",
        "think_ms"
      ],
      "title": "Event",
      "type": "object"
    },
    "Explanation": {
      "additionalProperties": false,
      "description": "One bot decision: its best candidates and why. For H1-H4 the first is the action\nplayed; H0's candidates are the uniform distribution it drew from.",
      "properties": {
        "agent": {
          "type": "string"
        },
        "tier": {
          "type": "string"
        },
        "chosen": {
          "type": "integer"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "context": {
          "items": {
            "$ref": "#/$defs/Term"
          },
          "type": "array"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/Candidate"
          },
          "type": "array"
        }
      },
      "required": [
        "agent",
        "tier",
        "chosen",
        "rule",
        "context",
        "candidates"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "GameResult": {
      "additionalProperties": false,
      "properties": {
        "game_id": {
          "type": "string"
        },
        "map": {
          "$ref": "#/$defs/MapName"
        },
        "rated": {
          "type": "boolean"
        },
        "opponent": {
          "$ref": "#/$defs/Player"
        },
        "seat": {
          "type": "integer"
        },
        "score": {
          "type": "integer"
        },
        "opponent_score": {
          "type": "integer"
        },
        "result": {
          "enum": [
            "win",
            "loss",
            "draw"
          ],
          "type": "string"
        },
        "finished": {
          "type": "string"
        }
      },
      "required": [
        "game_id",
        "map",
        "rated",
        "opponent",
        "seat",
        "score",
        "opponent_score",
        "result",
        "finished"
      ],
      "title": "GameResult",
      "type": "object"
    },
    "GameSummary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "map": {
          "$ref": "#/$defs/MapName"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "rated": {
          "type": "boolean"
        },
        "assist": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "n_players": {
          "type": "integer"
        },
        "seats": {
          "items": {
            "$ref": "#/$defs/SeatInfo"
          },
          "type": "array"
        },
        "human_seat": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "The person's seat in a play game."
        },
        "ply": {
          "description": "Actions played so far.",
          "type": "integer"
        },
        "created": {
          "type": "string"
        },
        "finished": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "map",
        "mode",
        "rated",
        "assist",
        "status",
        "n_players",
        "seats",
        "human_seat",
        "ply",
        "created",
        "finished"
      ],
      "title": "GameSummary",
      "type": "object"
    },
    "Glossary": {
      "additionalProperties": false,
      "description": "What every name in an explanation means.",
      "properties": {
        "terms": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "facts": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "context": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "rules": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "terms",
        "facts",
        "context",
        "rules"
      ],
      "title": "Glossary",
      "type": "object"
    },
    "KeepAction": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "keep",
          "type": "string"
        },
        "id": {
          "type": "integer"
        },
        "offer_indices": {
          "items": {
            "type": "integer"
          },
          "type": "array"
        },
        "count": {
          "type": "integer"
        },
        "tickets": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Tickets kept, to the keeper only."
        },
        "returned": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "description": "Tickets returned, to the keeper only."
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "offer_indices",
        "count",
        "tickets",
        "returned",
        "label"
      ],
      "title": "KeepAction",
      "type": "object"
    },
    "Leaderboard": {
      "additionalProperties": false,
      "description": "People and bots in one Bradley-Terry fit over arena and rated human games.",
      "properties": {
        "map": {
          "$ref": "#/$defs/MapName"
        },
        "n_players": {
          "type": "integer"
        },
        "anchor": {
          "type": "string"
        },
        "anchor_elo": {
          "description": "The anchor's rating, by definition.",
          "type": "number"
        },
        "games": {
          "type": "integer"
        },
        "blocks": {
          "type": "integer"
        },
        "standings": {
          "items": {
            "$ref": "#/$defs/Standing"
          },
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Why the board is empty, when it is."
        }
      },
      "required": [
        "map",
        "n_players",
        "anchor",
        "anchor_elo",
        "games",
        "blocks",
        "standings",
        "note"
      ],
      "title": "Leaderboard",
      "type": "object"
    },
    "LogEntry": {
      "additionalProperties": false,
      "properties": {
        "ply": {
          "type": "integer"
        },
        "seat": {
          "type": "integer"
        },
        "action": {
          "$ref": "#/$defs/Action"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "ply",
        "seat",
        "action",
        "text"
      ],
      "title": "LogEntry",
      "type": "object"
    },
    "MapName": {
      "enum": [
        "usa",
        "mini"
      ],
      "type": "string"
    },
    "MapRating": {
      "additionalProperties": false,
      "properties": {
        "map": {
          "$ref": "#/$defs/MapName"
        },
        "rating": {
          "$ref": "#/$defs/Rating"
        }
      },
      "required": [
        "map",
        "rating"
      ],
      "title": "MapRating",
      "type": "object"
    },
    "Meta": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "type": "integer"
        },
        "obs_version": {
          "type": "integer"
        },
        "assist": {
          "type": "string"
        },
        "maps": {
          "items": {
            "$ref": "#/$defs/MapName"
          },
          "type": "array"
        },
        "client_build": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "contract_version",
        "obs_version",
        "assist",
        "maps",
        "client_build"
      ],
      "title": "Meta",
      "type": "object"
    },
    "Mode": {
      "enum": [
        "play",
        "spectate"
      ],
      "type": "string"
    },
    "NewGame": {
      "discriminator": {
        "mapping": {
          "play": "#/$defs/NewPlayGame",
          "spectate": "#/$defs/NewSpectateGame"
        },
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NewPlayGame"
        },
        {
          "$ref": "#/$defs/NewSpectateGame"
        }
      ],
      "title": "NewGame"
    },
    "NewPlayGame": {
      "additionalProperties": false,
      "description": "Play a bot. A rated game seats you at random: seat 0 moves first, and first-player\nadvantage is real.",
      "properties": {
        "mode": {
          "const": "play",
          "type": "string"
        },
        "map": {
          "$ref": "#/$defs/MapName"
        },
        "opponent": {
          "description": "An agent spec from GET /api/agents.",
          "type": "string"
        },
        "player_id": {
          "type": "string"
        },
        "rated": {
          "default": true,
          "type": "boolean"
        },
        "seat": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unrated games only."
        }
      },
      "required": [
        "mode",
        "map",
        "opponent",
        "player_id"
      ],
      "title": "NewPlayGame",
      "type": "object"
    },
    "NewPlayer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "NewPlayer",
      "type": "object"
    },
    "NewSpectateGame": {
      "additionalProperties": false,
      "description": "Watch two bots, with every hand visible and each decision's reasoning.",
      "properties": {
        "mode": {
          "const": "spectate",
          "type": "string"
        },
        "map": {
          "$ref": "#/$defs/MapName"
        },
        "agents": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "mode",
        "map",
        "agents"
